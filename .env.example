# TypeSafe AI (Jev) — Early Access 승인 후 발급
# SDK가 이 이름을 자동으로 읽습니다. 이름을 바꾸면 클라이언트에 직접 넘겨야 합니다.
TYPESAFE_API_KEY=

# 선택: API 주소와 기본 모델을 바꿀 때만
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# LLM 비교 예제(ch01, ch06, ch09)에만 필요합니다.
OPENAI_API_KEY=

# 비교에 쓸 모델 이름. 사용 가능한 모델로 바꿔 주세요.
# 책의 실측은 상위 티어 gpt-6-astra, 하위 티어 gpt-6-luna 로 했습니다
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_SMALL=gpt-6-luna
OPENAI_MODEL_FRONTIER=gpt-6-astra
